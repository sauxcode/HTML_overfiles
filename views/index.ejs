<html lang="es"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Registros</title>
    <link href="https://jsdelivr.net" rel="stylesheet">
    <link rel="stylesheet" href="/visit.css">
</head>

<body> <!-- class="bg-light" -->
<div class="container py-5"> 

    <h2 class="text-center mb-4">Gestión de Usuarios</h2>
       
   <!-- VENTANA MODAL (Se abre automáticamente si 'usuarioEditar' existe) -->
    <div id="modalRegistro" class="modal-overlay activo">
    
        <div class="modal-contenido">
            <div class="modal-header card shadow-sm mb-4">
                <span style="color: black;">Nuevo Registro</span>
                
                    <button type="button" class="btn-cerrar-modal" onclick="cerrarModal()" title="Cerrar">×</button>
                
            </div>

            <div class="modal-body">
                <form action="/insertar" method="POST">
                    <div class="form-columna">
                        <div class="campo-grupo">
                            <label class="form-label">Nombre completo</label>
                            <input type="text" name="nombre" class="form-control" value="" required="">
                        </div>

                        <div class="campo-grupo">
                            <label class="form-label">Correo electrónico</label>
                            <input type="email" name="correo" class="form-control" value="" required="">
                        </div>

                        <div class="campo-grupo">
                            <label class="form-label">Teléfono</label>
                            <input type="text" name="telefono" class="form-control" value="" required="">
                        </div>
                    </div>

                    <div class="acciones-formulario">
                        <button type="submit" class="btn btn-success">
                            Insertar Registro
                        </button>

                        
                            <button type="button" class="btn btn-secondary" onclick="cerrarModal()">Cancelar</button>
                        
                    </div>
                </form>
            </div>
        </div>
</div>
    <!-- BARRA DE CONSULTA / BÚSQUEDA -->
    
    <form action="/" method="GET" class="A"> <!-- Barra de consulta (mb-3 d-flex gap-2) -->
       <button type="button" class="btn btn-outline-primary" onclick="abrirModal()">
            + Nuevo Registro
        </button>

        <input type="text" name="buscar" class="form-control" placeholder="Consultar por nombre o correo..." value="">
        <button type="submit" class="btn btn-outline-primary">Consultar</button> <!-- Para consultar -->
        <% if (busqueda) { %>
            <a href="/" class="btn btn-secondary">Limpiar</a>
        <% } %>
    </form> 
    
 
 
    <!-- TABLA DE REGISTROS GUARDADOS -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">Registros Guardados</div>
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Teléfono</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (usuarios.length > 0) { %>
                        <% usuarios.forEach(usuario => { %>
                            <tr>
                                <td><%= usuario.id %></td>
                                <td><%= usuario.nombre %></td>
                                <td><%= usuario.correo %></td>
                                <td><%= usuario.telefono %></td>
                                <td>
				<div class="acciones-tabla">
                                    <a href="/editar/<%= usuario.id %>" class="btn btn-warning btn-sm">Modificar</a>
                                    <a href="/borrar/<%= usuario.id %>" class="btn btn-danger btn-sm" onclick="return confirm('¿Seguro que deseas borrar este registro?')">Borrar</a>
				</div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center py-3">No hay registros guardados.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

<script>
    const modal = document.getElementById('modalRegistro');

    function abrirModal() {
        modal.classList.add('activo');
    }

    function cerrarModal() {
        modal.classList.remove('activo');
    }

    // Cerrar el modal si el usuario hace clic fuera de la caja blanca
    window.addEventListener('click', (evento) => {
        if (evento.target === modal) {
            
                cerrarModal();
            
        }
    });
</script>
</body></html>
